# Site file for a field node whose sensor waits to be spoken to: scapegoat is its C2.
# Copy, set every value, then: sudo deploy/field-node/install-field-node.sh --site <file>
# The installer copies it to /etc/field-node/site.env; later runs and field-node-mode read
# that copy. Format: KEY=value, no spaces around "=", lists space-separated in quotes. It is
# read by bash and by systemd (EnvironmentFile). Never put MAC addresses, mesh addresses or
# credentials here.
#
# This example uses the built-in toy pack (deploy/field-node/packs/toy). A protocol plugin
# ships its own pack and site template in plugins/<name>/field-node/.

# Components on this node, and the pack that describes the sensor (modes, profiles, capture).
COMPONENTS="network capture kids scapegoat"
FIELD_PACK=toy
# The mode the FIRST install starts in (one of the pack's modes). Later runs keep the mode
# chosen with field-node-mode unless --mode is given.
FIELD_MODE=lan

# ---- This node ------------------------------------------------------------------------------
NODE_NAME=scapegoat-node
NODE_ROLE="C2 node"
# The wired interface cabled to the sensor network. Static addresses only; no DHCP on it.
SENSOR_IFACE=eth0

# ---- Mode lan (the toy pack's only mode) ---------------------------------------------------
LAN_LOCAL_CIDR=192.0.2.10/24
LAN_PEER=192.0.2.81:47000
LAN_PEER_CANDIDATES="192.0.2.81:47000"

# ---- scapegoat ------------------------------------------------------------------------------
ALLOW_NET_CONTROL=true
ISLAND_REST=http://127.0.0.1:8000

# ---- C2 outputs: the sensor's tracks in standard formats (needs goat-transformers) ----------
# One track path per sensor: do not also publish these tracks from a kid.
# SCAPEGOAT_OUTPUTS="cat062"
# OUTPUT_CAT062_FORMAT=asterix-cat062          # asterix-cat062 | cot-xml | sapient
# OUTPUT_CAT062_TO="udp://239.255.62.1:8600"   # placeholder: the receiving C2's group and port   # udp://IP:PORT (multicast too) or zenoh:<key>
# OUTPUT_CAT062_SAC=1
# OUTPUT_CAT062_SIC=7
# Component "transformers" (add it to COMPONENTS) installs goat-transformers at
# /opt/goat-transformers from a pinned ref; scapegoat finds it there.
# GOAT_TRANSFORMERS_REF=<tag or commit of USAREUR-AF/goat-transformers>
# GOAT_TRANSFORMERS_COMMIT=<its 40-character commit id>     # or, for a tarball:
# GOAT_TRANSFORMERS_SHA256=<sha256 of the .tar.gz>
# GOAT_TRANSFORMERS_TARBALL=<local path, for a node without internet>
# OUTPUT_CAT062_ENABLED=true

# ---- Capture: first-bite (first-bite's tap) | units (a pack's own) | off ------------------
CAPTURE=off

# ---- Billie kids (none here; see standard-format-radar.env for the form) --------------------
KIDS=
