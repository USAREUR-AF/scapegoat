#!/usr/bin/env bash
# scapegoat-field-config: field-node mode hook (contributed by scapegoat).
#   scapegoat-field-config <mode> [--check] [--no-restart]
# Renders /etc/scapegoat/modes/<mode>.toml for every mode of the pack and
# /etc/scapegoat/scapegoat.toml for <mode>, from the site file and the pack (profile per
# mode, session, peer, candidates, forward targets, session.toml.in). scapegoat's own config
# loader checks each one first. Restarts scapegoat when its config changed. Exit 3 in --check
# mode when something would change. Run by field-node-mode with FIELD_ROOT, FIELD_ENV and
# FIELD_PACK_DIR set.
set -euo pipefail

ROOT=${FIELD_ROOT:-}
ENV_FILE=${FIELD_ENV:-$ROOT/etc/field-node/site.env}
PACK=${FIELD_PACK_DIR:-$ROOT/etc/field-node/pack}
MODES_DIR="$ROOT/etc/scapegoat/modes"
CONF="$ROOT/etc/scapegoat/scapegoat.toml"
ME=scapegoat-field-config

MODE=${1:?usage: $ME <mode> [--check] [--no-restart]}
shift
CHECK=0
RESTART=1
for a in "$@"; do
  case "$a" in --check) CHECK=1 ;; --no-restart) RESTART=0 ;; *) echo "$ME: unknown option $a" >&2; exit 2 ;; esac
done
set -a
# shellcheck disable=SC1090,SC1091
. "$ENV_FILE"
# shellcheck disable=SC1091
. "$PACK/pack.env"
set +a
MODES=${MODES:?the field-node pack defines no MODES}

DRIFT=0
say() { echo "$ME: $*"; }
change() { DRIFT=1; if [[ $CHECK -eq 1 ]]; then say "would $*"; else say "$*"; fi; }
key() { echo "$1" | tr '[:lower:]-' '[:upper:]_'; }

forward_targets() {  # SCAPEGOAT_FORWARD, else the kid named in SCAPEGOAT_FORWARD_KID, else KID_BIND:KID_PORT
  local out="" t b p
  if [[ -n "${SCAPEGOAT_FORWARD:-}" ]]; then
    for t in $SCAPEGOAT_FORWARD; do out+="${out:+, }\"$t\""; done
  elif [[ -n "${SCAPEGOAT_FORWARD_KID:-}" ]]; then
    b="KID_$(key "$SCAPEGOAT_FORWARD_KID")_BIND"; p="KID_$(key "$SCAPEGOAT_FORWARD_KID")_PORT"
    [[ -n "${!p:-}" ]] && out="\"${!b:-127.0.0.1}:${!p}\""
  elif [[ -n "${KID_PORT:-}" ]]; then
    out="\"${KID_BIND:-127.0.0.1}:${KID_PORT}\""
  fi
  printf '[%s]' "$out"
}

load_mode() {
  PROFILE="" LOCAL_CIDRS_VARS="" PEER_VAR="" CANDIDATES_VAR="" EXTRA_TOML=""
  # shellcheck disable=SC1090
  . "$PACK/modes/$1.mode"
}
toml_list() { local out="" x; for x in $1; do out+="${out:+, }\"$x\""; done; printf '[%s]' "$out"; }

outputs_toml() {  # SCAPEGOAT_OUTPUTS="<name> ..." and OUTPUT_<NAME>_* -> [outputs.<name>] tables
  local n K v
  [[ -n "${GOAT_TRANSFORMERS_PATH:-}" ]] && printf '\n[transformers]\npath = "%s"\n' "$GOAT_TRANSFORMERS_PATH"
  for n in ${SCAPEGOAT_OUTPUTS:-}; do
    K="OUTPUT_$(key "$n")"
    printf '\n# C2 output %s, from OUTPUT_%s_* in the site file.\n[outputs.%s]\n' "$n" "$(key "$n")" "$n"
    v="${K}_FORMAT"; printf 'format = "%s"\n' "${!v:?site file: $v is required for output $n}"
    v="${K}_ENABLED"; printf 'enabled = %s\n' "${!v:-true}"
    v="${K}_TO"; printf 'to = %s\n' "$(toml_list "${!v:?site file: $v is required for output $n}")"
    v="${K}_SESSIONS"; [[ -n "${!v:-}" ]] && printf 'sessions = %s\n' "$(toml_list "${!v}")"
    v="${K}_SAC"; [[ -n "${!v:-}" ]] && printf 'sac = %s\n' "${!v}"
    v="${K}_SIC"; [[ -n "${!v:-}" ]] && printf 'sic = %s\n' "${!v}"
    v="${K}_HOW"; [[ -n "${!v:-}" ]] && printf 'how = "%s"\n' "${!v}"
    v="${K}_STALE_S"; [[ -n "${!v:-}" ]] && printf 'stale_s = %s\n' "${!v}"
    v="${K}_NODE_ID"; [[ -n "${!v:-}" ]] && printf 'node_id = "%s"\n' "${!v}"
    v="${K}_UID_PREFIX"; [[ -n "${!v:-}" ]] && printf 'uid_prefix = "%s"\n' "${!v}"
    v="${K}_MULTICAST_TTL"; [[ -n "${!v:-}" ]] && printf 'multicast_ttl = %s\n' "${!v}"
  done
  return 0
}

render() {  # $1 = mode
  load_mode "$1"
  local v first="" peer cands settings
  for v in $LOCAL_CIDRS_VARS; do first=${!v%% *}; break; done
  peer=${!PEER_VAR}
  cands=${!CANDIDATES_VAR:-}
  settings=$(python3 -c 'import os,string,sys; print(string.Template(open(sys.argv[1]).read()).substitute(os.environ))' \
             "$PACK/session.toml.in")
  cat <<EOT
# Generated by $ME from /etc/field-node/site.env and the ${PACK_NAME} pack (mode $1).
# Do not edit by hand: change the site file, then run: sudo field-node-mode $1
profile = "$PROFILE"
node_name = "$NODE_NAME"
node_role = "${NODE_ROLE:-}"
island_rest = "${ISLAND_REST:-}"
allow_net_control = ${ALLOW_NET_CONTROL:-false}
expected_local_address = "$first"
topology = "same-lan"

[sessions.${SESSION_ID}]
local = "0.0.0.0:${SENSOR_PORT}"
peer = "$peer"
peer_candidates = $(toml_list "$cands")
${EXTRA_TOML}
# Every received message is copied to the Billie kid listening here.
forward = $(forward_targets)
forward_mode = "message"

${settings}
$(outputs_toml)
EOT
}

validate() {
  local prog="$ROOT/opt/scapegoat" tmp rc=0
  [[ -d "$prog/scapegoat" ]] || prog=${FIELD_PROGRAM:-}
  [[ -n "$prog" && -d "$prog/scapegoat" ]] || { echo "$ME: scapegoat not found; config not validated" >&2; return 0; }
  tmp=$(mktemp)
  printf '%s\n' "$1" > "$tmp"
  PYTHONPATH="$prog" python3 -c 'import sys; from scapegoat.core import config; config.load(sys.argv[1])' "$tmp" || rc=$?
  rm -f "$tmp"
  [[ $rc -eq 0 ]] || { echo "$ME: the rendered config is refused by scapegoat (above); nothing changed" >&2; exit 1; }
}

put() {
  local content=$1 path=$2
  if [[ -f "$path" ]] && [[ "$(cat "$path")" == "$content" ]]; then return 1; fi
  change "write $path"
  [[ $CHECK -eq 1 ]] && return 0
  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$content" > "$path.tmp"
  chmod 644 "$path.tmp"
  mv "$path.tmp" "$path"
}

for m in $MODES; do validate "$(render "$m")"; done
for m in $MODES; do put "$(render "$m")" "$MODES_DIR/$m.toml" || true; done
changed=0
put "$(render "$MODE")" "$CONF" && changed=1
if [[ $changed -eq 1 && $RESTART -eq 1 && -f "$ROOT/etc/systemd/system/scapegoat.service" ]]; then
  change "restart scapegoat"
  [[ $CHECK -eq 1 ]] || systemctl restart scapegoat
fi
if [[ $CHECK -eq 1 && $DRIFT -eq 1 ]]; then exit 3; fi
exit 0
