# Built-in field-node pack for a node that only needs static addresses on the sensor
# interface (no surrogate C2): "static" sets SENSOR_CIDRS; "static-hosts" sets them with no
# subnet route and routes only SENSOR_HOST_ROUTES; "dhcp" only checks them.
PACK_NAME=plain
MODES="static static-hosts dhcp"
MODE_ALIASES=""
MODE_TOOL_ALIAS=""
NETPLAN_SUFFIX=sensor
CAPTURE_UNITS=""
CAPTURE_TIMER_STARTED=""
CAPTURE_SCRIPTS=""
TAP_ENVS=""
