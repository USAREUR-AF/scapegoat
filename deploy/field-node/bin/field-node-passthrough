#!/usr/bin/env python3
"""field-node-passthrough: publish each UDP datagram, unchanged, to the local Billie island.

For a sensor whose format no kid ingests yet: every datagram that arrives on BIND:PORT from
SOURCE_CIDR is PUT as-is to <ISLAND_REST>/<KEY>. The island bridge adds the node's slot
prefix, so the fabric topic is <slot>/<KEY>. Datagrams from other senders are dropped and
counted. Standard library only. Settings come from the environment (systemd EnvironmentFile
/etc/field-node/passthrough-<name>.env): PT_BIND, PT_PORT, PT_SOURCE_CIDR, PT_KEY,
PT_ISLAND_REST, PT_CONTENT_TYPE (default application/octet-stream).
"""

import ipaddress
import os
import socket
import sys
import time
import urllib.request

REPORT_EVERY_S = 60.0


def main() -> int:
    bind = os.environ.get("PT_BIND", "0.0.0.0")
    port = int(os.environ["PT_PORT"])
    allowed = ipaddress.ip_network(os.environ.get("PT_SOURCE_CIDR", "0.0.0.0/0"), strict=False)
    url = os.environ.get("PT_ISLAND_REST", "http://127.0.0.1:8000").rstrip("/") + "/" + os.environ["PT_KEY"].lstrip("/")
    ctype = os.environ.get("PT_CONTENT_TYPE", "application/octet-stream")
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind((bind, port))
    sock.settimeout(1.0)
    counts = {"received": 0, "published": 0, "dropped_sender": 0, "failed": 0}
    last_report = time.monotonic()
    print(f"field-node-passthrough: UDP {bind}:{port} from {allowed} -> PUT {url}", flush=True)
    while True:
        try:
            data, (host, _) = sock.recvfrom(65535)
            counts["received"] += 1
            if ipaddress.ip_address(host) not in allowed:
                counts["dropped_sender"] += 1
            else:
                req = urllib.request.Request(url, data=data, method="PUT", headers={"Content-Type": ctype})
                try:
                    urllib.request.urlopen(req, timeout=5).close()
                    counts["published"] += 1
                except Exception as exc:  # the island may be restarting; count and go on
                    counts["failed"] += 1
                    if counts["failed"] in (1, 10, 100) or counts["failed"] % 1000 == 0:
                        print(f"field-node-passthrough: PUT failed ({exc}); {counts['failed']} so far", flush=True)
        except socket.timeout:
            pass
        now = time.monotonic()
        if now - last_report >= REPORT_EVERY_S:
            last_report = now
            print("field-node-passthrough: " + ", ".join(f"{k} {v}" for k, v in counts.items()), flush=True)


if __name__ == "__main__":
    sys.exit(main())
