# Installed by deploy/field-node/install-field-node.sh (component passthrough).
[Unit]
Description=field node: publish UDP datagrams unchanged to the Billie island (%i)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/field-node/passthrough-%i.env
ExecStart=/usr/bin/python3 /usr/local/libexec/field-node-passthrough
DynamicUser=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
