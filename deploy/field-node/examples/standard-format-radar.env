# Site file for a field node whose radar sends a standard format on its own: no surrogate C2
# (no scapegoat). The node holds an address on the radar network, captures the link with
# first-bite's tap, and runs one Billie kid that ingests the radar's output.
# Copy, set every value, then: sudo deploy/field-node/install-field-node.sh --site <file>

COMPONENTS="network capture kids"
# The built-in plain pack: mode "static" sets SENSOR_CIDRS; mode "dhcp" (interface on DHCP)
# only checks that SENSOR_CIDRS is there.
FIELD_PACK=plain
FIELD_MODE=static

NODE_NAME=radar-node
NODE_ROLE="radar ingest"
# The wired interface on the radar network: eth0, or a USB Ethernet adapter (enx...).
# Find it with: ip -br link   (and scapegoat net / ip neigh to see where the radar is).
SENSOR_IFACE=eth0
# This node's addresses on the radar network (space-separated address/prefix).
SENSOR_CIDRS="192.0.2.10/24"

# ---- Capture: first-bite's tap; one instance per name=settings file -------------------------
CAPTURE=first-bite
FIRST_BITE_TAP_INSTALL=/opt/first-bite/deployment/tap/install.sh
CAPTURE_TAPS="radar=/etc/field-node/taps/radar-tap.env"

# ---- Billie kids --------------------------------------------------------------------------------
KIDS="radar-ingest"
KID_RADAR_INGEST_VERSION=0.1.0
KID_RADAR_INGEST_BUNDLE=/opt/kids/radar-ingest_0.1.0.tar.gz
KID_RADAR_INGEST_SHA256=
KID_RADAR_INGEST_TRANSPORT=udp
# The kid listens on this node's radar-network address; the radar sends there.
KID_RADAR_INGEST_BIND=192.0.2.10
KID_RADAR_INGEST_PORT=4000
KID_RADAR_INGEST_SOURCE_CIDR=192.0.2.0/24
# CAT062 identities: "<source>:<sac>:<sic> ..."
KID_RADAR_INGEST_CAT062=""
